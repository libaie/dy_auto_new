# Server
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Device secret (shared between server and device)
DEVICE_SECRET=change-me-to-a-random-string

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-jwt-secret-key
JWT_EXPIRE_HOURS=24

# Real paid provider worker safety gate
# Keep this at 1 until dy_auto has a DB-backed cross-process provider quota.
DY_AUTO_PROVIDER_SUBMIT_WORKER_COUNT=1
