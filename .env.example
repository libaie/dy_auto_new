# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Device secret (shared between server and device)
DEVICE_SECRET=change-me-to-a-random-string

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-jwt-secret-key
JWT_EXPIRE_HOURS=24

# Real paid provider worker safety gate
# Keep this at 1 until dy_auto has a DB-backed cross-process provider quota.
DY_AUTO_PROVIDER_SUBMIT_WORKER_COUNT=1

# Jev decision model (independent from the text-generation provider)
DECISION_ENABLED=false
DECISION_MODEL=typesafe-ai/jev
DECISION_API_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
DECISION_API_KEY=
DECISION_MIN_CONFIDENCE=0.5
DECISION_MIN_PROBABILITY=0.75
# Required when saving the decision key through the admin settings page.
# Set a private random value; keep an existing deployment's key unchanged.
# ENCRYPTION_KEY=
